# Local Mac development only. This file is copied to .env.development, which is
# ignored by Git. Do not reuse production credentials or production storage paths.

CG_ENVIRONMENT=development
CG_DATABASE_URL=postgresql+asyncpg://comfygallery:comfygallery-local-dev@127.0.0.1:55432/comfygallery_dev
CG_REDIS_URL=redis://127.0.0.1:56379/0
CG_ADMIN_USERNAME=admin
CG_ADMIN_PASSWORD=comfygallery-local-development
CG_SESSION_COOKIE_SECURE=false
CG_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CG_LOG_LEVEL=INFO

CG_MANAGED_ROOT=./data/development/managed
CG_STAGING_ROOT=./data/development/staging
CG_EXPORT_ROOT=./data/development/exports
CG_BACKUP_ROOT=./data/development/backups
CG_RUNTIME_ROOT=./data/development/runtime
CG_ALLOWED_SOURCE_ROOTS=./data/development/import,./testdata/golden
CG_MINIMUM_FREE_BYTES=104857600

# Set this only when local node-registry synchronization should query ComfyUI.
CG_COMFYUI_BASE_URL=

DEV_POSTGRES_DB=comfygallery_dev
DEV_POSTGRES_USER=comfygallery
DEV_POSTGRES_PASSWORD=comfygallery-local-dev
DEV_POSTGRES_PORT=55432
DEV_REDIS_PORT=56379
