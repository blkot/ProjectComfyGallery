CG_ENVIRONMENT=development
CG_DATABASE_URL=postgresql+asyncpg://comfygallery:change-database-password@postgres:5432/comfygallery
CG_REDIS_URL=redis://redis:6379/0
CG_ADMIN_USERNAME=admin
CG_ADMIN_PASSWORD=replace-with-a-long-random-password
CG_SESSION_COOKIE_SECURE=false
CG_SESSION_TTL_HOURS=168
CG_LOGIN_ATTEMPT_LIMIT=8
CG_LOGIN_ATTEMPT_WINDOW_SECONDS=300
CG_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
CG_LOG_LEVEL=INFO
CG_MANAGED_ROOT=/data/managed
CG_STAGING_ROOT=/data/staging
CG_EXPORT_ROOT=/data/exports
CG_BACKUP_ROOT=/backups
CG_RUNTIME_ROOT=/data/runtime
CG_ALLOWED_SOURCE_ROOTS=/imports
CG_MAX_UPLOAD_BYTES=134217728
CG_MINIMUM_FREE_BYTES=536870912
CG_WORKFLOW_METADATA_MAX_BYTES=67108864
CG_WORKFLOW_JSON_MAX_DEPTH=128
CG_WORKFLOW_JSON_MAX_ITEMS=250000
CG_WORKFLOW_MAX_NODES=20000
CG_COMFYUI_BASE_URL=
CG_REGISTRY_HTTP_TIMEOUT_SECONDS=180
CG_REGISTRY_MAX_RESPONSE_BYTES=67108864
CG_REGISTRY_MAX_NODE_DEFINITIONS=20000
CG_REGISTRY_METADATA_CONCURRENCY=4
CG_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
CG_WORKER_STALE_AFTER_SECONDS=90
CG_JOB_STALE_AFTER_SECONDS=1800
CG_QUEUED_JOB_RECOVERY_AFTER_SECONDS=60
CG_RUNNING_JOB_RECOVERY_AFTER_SECONDS=300
CG_SCAN_ACTOR_TIME_LIMIT_SECONDS=0
CG_BACKUP_EXPECTED_INTERVAL_HOURS=30
CG_DISK_WARNING_PERCENT=90

POSTGRES_DB=comfygallery
POSTGRES_USER=comfygallery
POSTGRES_PASSWORD=change-database-password
WEB_PORT=8080
MEDIA_DATA_ROOT=./data/media
IMPORT_ROOT=./data/import
BACKUP_ROOT=./data/backups
CG_BACKUP_INTERVAL_SECONDS=86400
CG_BACKUP_DAILY_KEEP=7
CG_BACKUP_WEEKLY_KEEP=4
TZ=Asia/Shanghai
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
CG_IMAGE_NAMESPACE=project-comfy-gallery
CG_IMAGE_TAG=0.1.0-rc.7

POSTGRES_MEMORY_LIMIT=1G
REDIS_MEMORY_LIMIT=256M
API_MEMORY_LIMIT=768M
WORKER_MEMORY_LIMIT=2G
BACKUP_MEMORY_LIMIT=256M
WEB_MEMORY_LIMIT=128M
